{
  "name": "flowst-airs-bring-your-source",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev --dotenv .env.local",
    "demo": "node scripts/run-source-fixtures.mjs",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --maxWorkers=1",
    "test:sources:e2e": "playwright test --config playwright.sources.config.ts",
    "mcp:github": "node scripts/start-github-study-mcp.mjs",
    "mcp:review": "node --import tsx scripts/review-source-mcp.mjs",
    "docs:generate": "node scripts/generate-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "repo:check": "node scripts/check-public-export.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1117.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1117.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1117.0",
    "@aws-sdk/client-dynamodb": "^3.1116.0",
    "@aws-sdk/client-polly": "^3.1117.0",
    "@aws-sdk/client-rekognition": "^3.1117.0",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/client-transcribe-streaming": "^3.1117.0",
    "@aws-sdk/lib-dynamodb": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1117.0",
    "@elevenlabs/client": "^1.25.0",
    "@elevenlabs/elevenlabs-js": "^2.65.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@mozilla/readability": "0.6.0",
    "@napi-rs/canvas": "0.1.80",
    "@vercel/oidc-aws-credentials-provider": "^3.3.5",
    "@vite-pwa/nuxt": "^1.0.4",
    "dotenv": "^17.4.2",
    "fabric": "^7.1.0",
    "ipaddr.js": "2.5.0",
    "jose": "^6.2.10",
    "jsdom": "26.1.0",
    "jszip": "^3.10.2",
    "lucide-vue-next": "^0.468.0",
    "mammoth": "^1.10.0",
    "nuxt": "^4.0.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdf-parse-modern": "npm:pdf-parse@^2.4.5",
    "vue": "^3.5.18",
    "vue-router": "^5.2.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "^24.3.0",
    "sharp": "^0.35.4",
    "tsx": "4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.11"
  }
}
