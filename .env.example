NUXT_PUBLIC_APP_SURFACE=air
FLOWST_AUTH_MODE=cognito
NUXT_PUBLIC_AUTH_REQUIRED=false
AIRS_GUEST_ENABLED=true
# A random server-only secret of at least 32 characters is required for production guest sessions.
# Growth is the normal Home in development and production. Set false only for rollback.
AIR_GROWTH_ENABLED=true
AIRS_GUEST_SECRET=
NUXT_PUBLIC_API_BASE_URL=/api
AWS_REGION=us-east-1
FLOWST_COGNITO_USER_POOL_ID=
FLOWST_COGNITO_CLIENT_ID=
FLOWST_DYNAMO_TABLE=
FLOWST_CURRICULUM_BUCKET=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AIR_TEXT_PROVIDER=groq
AIR_OBJECTIVE_FLOW_ENABLED=true
AIR_VOICE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_STUDY_AGENT_ID=
ELEVENLABS_STUDY_LLM_SECRET=
ELEVENLABS_STUDY_LLM_URL=
AIR_GITHUB_READ_TOKEN=
AIR_SOURCE_FIXTURE_MODE=false
AIR_VIDEO_ENABLED=false
AIR_VIDEO_API_KEY=
AIR_VIDEO_WEBHOOK_ID=
AIR_VIDEO_WEBHOOK_SECRET=
AIR_VIDEO_USD_PER_MINUTE=
AIR_VIDEO_MONTHLY_BUDGET_USD=

# Deployment-wide guest model-task allowance; set to 0 to disable model work.
AIRS_GUEST_DAILY_MODEL_LIMIT=30
# Voice has no cumulative per-study quota or daily guest voice-start quota.

# On-demand Nova 2 Lite text/function testing: $5 standalone of the $20 combined allowance.
# Select AIR_TEXT_PROVIDER=aws explicitly. No automatic provider fallback.
# Server-only Bedrock key (AWS_BEDROCK_APIKEY also accepted); key labels are not model IDs.
AWS_BEARER_TOKEN_BEDROCK=
FLOWST_STUDY_BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
